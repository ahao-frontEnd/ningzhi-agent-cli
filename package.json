{
  "name": "ningzhi_Agent_Cli",
  "version": "0.0.1",
  "description": "A personal AI Agent like OpenClaw, including tools, skills, memory, hook, sub-agent, MCP sever, etc. Run in the terminal.",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ningzhi": "dist/agent/cli.js"
  },
  "scripts": {
    "build": "tsc && cp -r src/agent/skills/* dist/agent/skills/",
    "dev": "ts-node src/agent/cli.ts",
    "start": "node dist/agent/cli.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist"
  },
  "keywords": [],
  "author": "柠致",
  "docs": "https://chat.ningzhi2.site/",
  "license": "ISC",
  "dependencies": {
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.12",
    "@langchain/openai": "1.5.10",
    "@langchain/tavily": "1.2.0",
    "boxen": "8.0.1",
    "figlet": "1.11.4",
    "chalk": "5.6.2",
    "commander": "15.0.0",
    "dotenv": "17.4.2",
    "langchain": "1.5.10",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "26.2.0",
    "jest": "30.4.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
