{
  "name": "ningzhi-agent-cli",
  "version": "0.2.3",
  "description": "A personal AI Agent like OpenClaw, including tools, skills, memory, hook, sub-agent, MCP sever, etc. Run in the terminal.",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ningzhi": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && pnpm copy:skills",
    "copy:skills": "node -e \"require('fs').cpSync('src/agent/skills', 'dist/agent/skills', { recursive: true })\"",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rm -rf dist"
  },
  "keywords": [],
  "author": "柠致",
  "docs": "https://www.npmjs.com/package/ningzhi-agent-cli?activeTab=readme",
  "license": "ISC",
  "dependencies": {
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.12",
    "@langchain/langgraph-checkpoint-sqlite": "1.0.4",
    "@langchain/openai": "1.5.10",
    "@langchain/tavily": "1.2.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/better-sqlite3": "7.6.13",
    "better-sqlite3": "12.11.1",
    "boxen": "8.0.1",
    "figlet": "1.11.4",
    "chalk": "5.6.2",
    "cli-table3": "0.6.5",
    "commander": "15.0.0",
    "dotenv": "17.4.2",
    "langchain": "1.5.10",
    "streammark": "1.0.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "26.2.0",
    "jest": "30.4.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
