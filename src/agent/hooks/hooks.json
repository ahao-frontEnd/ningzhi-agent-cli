{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "read_file",
        "command": "node ./src/agent/hooks/protect_env.js"
      },
      { "matcher": "exec", "command": "node ./src/agent/hooks/protect_env.js" },
      {
        "matcher": "run_py",
        "command": "node ./src/agent/hooks/protect_env.js"
      },
      {
        "matcher": "run_js",
        "command": "node ./src/agent/hooks/protect_env.js"
      }
    ],
    "PostToolUse": [
      { "matcher": "*", "command": "node ./src/agent/hooks/record_tool.js" }
    ],
    "SessionStart": []
  }
}
